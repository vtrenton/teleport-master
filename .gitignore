# Terraform state
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Local Terraform directory (downloaded providers/modules)
.terraform/

# Crash logs
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated SSH key material
out/

# Generated Helm values (rendered by terraform from terraform/templates/)
/teleport-cluster-values.yaml
